# Copia este archivo a `.env` y rellena los valores.
# El .env real nunca se sube: contiene la clave que permite enviar correo.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=studio@enfoco.site

# Desde donde sale la confirmación que ve el cliente.
MAIL_FROM=En Foco Studio <studio@enfoco.site>

# Desde donde sale el aviso interno. Opcional: si se deja vacío se usa
# web@<tu dominio>. NO debe coincidir con CONTACT_EMAIL, o Google lo trata
# como suplantación y lo manda a spam.
NOTIFY_FROM=En Foco · Web <web@enfoco.site>

PORT=5174
